# LifeSync Backend Environment Variables Template
SERVER_PORT=8085

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/lifesync
DB_USERNAME=postgres
DB_PASSWORD=your_database_password

# JWT Secret & Expiration
JWT_SECRET=YourSuperSecretKeyMustBeAtLeast256BitsLongForHS256Algorithm123456789
JWT_EXPIRATION_MS=86400000

# Gmail SMTP for OTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
GMAIL_USERNAME=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Telegram Bot (Optional)
LIFESYNC_TELEGRAM_BOT_TOKEN=
TELEGRAM_API_URL=https://api.telegram.org/bot

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

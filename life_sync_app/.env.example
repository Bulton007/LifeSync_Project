# LifeSync Mobile App Environment Variables Template
# Android emulator development: pass
# --dart-define=ANDROID_USE_EMULATOR_ALIAS=true to map localhost to 10.0.2.2.
# Physical Android devices need a reachable LAN URL (for example,
# http://192.168.1.10:8085) or an HTTPS deployment origin.
API_BASE_URL=https://lifesync-backend-bultoncr7-dev.apps.rm3.7wse.p1.openshiftapps.com
# Production example (replace with the origin from `oc get route`; do not add /api):
# API_BASE_URL=https://<production-api-origin>
API_CONNECT_TIMEOUT_SECONDS=8
API_SEND_TIMEOUT_SECONDS=8
API_RECEIVE_TIMEOUT_SECONDS=10

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CONNECT_TIMEOUT_SECONDS=45
GEMINI_RECEIVE_TIMEOUT_SECONDS=60
GEMINI_SEND_TIMEOUT_SECONDS=45

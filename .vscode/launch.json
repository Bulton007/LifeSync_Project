{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LifeSync Mobile App (Debug)",
      "cwd": "life_sync_app",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "LifeSync Mobile App (Profile)",
      "cwd": "life_sync_app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "LifeSync Mobile App (Release)",
      "cwd": "life_sync_app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=.env"
      ]
    }
  ]
}
